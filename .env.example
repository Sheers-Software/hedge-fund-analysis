# Server-side API keys (optional fallback when a request carries no in-app key).
#
# Local dev: copy this file to `.env.local` and fill in real values.
# Vercel:    add these in Project → Settings → Environment Variables, then redeploy.
#            (`.env.local` is gitignored and is NOT deployed.)

# Required for AI report generation. Get one at https://aistudio.google.com/
GEMINI_API_KEY=

# Recommended. Powers ticker search and the real-time data fallback used when
# Yahoo Finance is blocked on Vercel's IPs. Get one at https://finnhub.io/
FINNHUB_API_KEY=

# ── Meta GTM funnel (all client-exposed, hence NEXT_PUBLIC_) ──────────
# Meta Pixel ID. When set, the pixel loads and fires the conversion machine's
# event ladder: PageView / ViewContent / ViewVerdict / CompleteRegistration /
# Purchase (tripwire | subscription | expansion). Leave blank in dev — all
# analytics calls become safe no-ops.
NEXT_PUBLIC_FB_PIXEL_ID=

# Conversions API (CAPI) — server-side dedup of the pixel events (Step 5 wires
# the real Graph API send; until then /api/meta/capi no-ops). Server-only.
META_CAPI_DATASET_ID=
META_CAPI_ACCESS_TOKEN=

# ── Stripe Payment Links (annual ladder + $7 tripwire) ────────────────
# The annual checkout links. If blank, purchases unlock optimistically so the
# funnel stays fully testable locally. (NEXT_PUBLIC_STRIPE_PAYMENT_LINK[_PREMIUM]
# from the old monthly model are still read as a fallback.)
NEXT_PUBLIC_STRIPE_LINK_ANNUAL=
NEXT_PUBLIC_STRIPE_LINK_ANNUAL_PREMIUM=
NEXT_PUBLIC_STRIPE_LINK_TRIPWIRE=

# Step 3 WTP test: annual renewal price, A/B-switchable with no redeploy.
# Accepts 279 (default) or 299. Intro is always $99.
NEXT_PUBLIC_ANNUAL_RENEWAL_PRICE=279

# Canonical site URL — used for OpenGraph/metadata absolute URLs.
NEXT_PUBLIC_SITE_URL=https://apexalpha.app
